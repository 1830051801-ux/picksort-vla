Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 238; 241; 243
    Fixed Frame: base_link
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Workcell Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Color: 145; 151; 156
      Alpha: 0.45
    - Class: rviz_default_plugins/RobotModel
      Name: Sorting Arm
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Frame Timeout: 15
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.45
      Focal Point:
        X: 0.34
        Y: 0.0
        Z: 0.25
      Pitch: 0.48
      Yaw: 0.82
Window Geometry:
  Width: 1280
  Height: 800
